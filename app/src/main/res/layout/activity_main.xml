<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/editor_panel">

        <!-- No subtitle: the phase line duplicated what the log already said, for a whole strip of
             height the model could have used. -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:menu="@menu/main_menu"
            app:title="@string/app_name"
            app:titleTextColor="@color/editor_text" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- The viewport keeps whatever the panels and the two strips do not need: the model and its
         atlas are the point of the screen, so the chrome is fixed in height instead of weighted. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <com.g3d.editor.ModelView
                android:id="@+id/viewport"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/viewportHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_margin="6dp"
                android:background="@color/overlay_background"
                android:padding="3dp"
                android:text="@string/viewport_hint"
                android:textColor="@color/editor_text_dim"
                android:textSize="10sp" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/hierarchyPanel"
            android:layout_width="200dp"
            android:layout_height="match_parent"
            android:background="@color/editor_panel"
            android:orientation="vertical"
            android:padding="6dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hierarchy_title"
                android:textAllCaps="true"
                android:textColor="@color/editor_text_dim"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sceneSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="2dp"
                android:paddingBottom="4dp"
                android:textColor="@color/editor_text_dim"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/hierarchyList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/uvPanel"
            android:layout_width="232dp"
            android:layout_height="match_parent"
            android:background="@color/editor_panel"
            android:orientation="vertical"
            android:padding="6dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/uv_title"
                android:textAllCaps="true"
                android:textColor="@color/editor_text_dim"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/uvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="2dp"
                android:paddingBottom="4dp"
                android:textColor="@color/editor_text_dim"
                android:textSize="11sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/uv_generate_title"
                android:textAllCaps="true"
                android:textColor="@color/editor_text_dim"
                android:textSize="10sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/uvPadding"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:autofillHints="none"
                    android:hint="@string/uv_padding_hint"
                    android:inputType="number"
                    android:maxLength="4"
                    android:text="@string/uv_padding_default"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/uvResolution"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:autofillHints="none"
                    android:hint="@string/uv_resolution_hint"
                    android:inputType="number"
                    android:maxLength="5"
                    android:text="@string/uv_resolution_default"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/uvGenerate"
                    style="@style/ToolButton.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/uv_generate" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/uvSelectAll"
                    style="@style/ToolButton.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/uv_select_all" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/uvSelectNone"
                    style="@style/ToolButton.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="@string/uv_select_none" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/uvAdditive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/uv_additive"
                android:textColor="@color/editor_text"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/uv_translate_title"
                android:textAllCaps="true"
                android:textColor="@color/editor_text_dim"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- A cross of four buttons is shorter than a row of four arrows with labels. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/uvMoveUp"
                    style="@style/ToolButton.Outlined"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:text="@string/uv_move_up" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/uvMoveLeft"
                        style="@style/ToolButton.Outlined"
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:text="@string/uv_move_left" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/uvMoveDown"
                        style="@style/ToolButton.Outlined"
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:text="@string/uv_move_down" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/uvMoveRight"
                        style="@style/ToolButton.Outlined"
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:text="@string/uv_move_right" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/uvRotateMinus90"
                    style="@style/ToolButton.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/uv_rotate_minus_90" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/uvRotateMinus15"
                    style="@style/ToolButton.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="@string/uv_rotate_minus_15" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/uvRotatePlus15"
                    style="@style/ToolButton.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="@string/uv_rotate_plus_15" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/uvRotatePlus90"
                    style="@style/ToolButton.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="@string/uv_rotate_plus_90" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/uvScaleDown"
                    style="@style/ToolButton.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/uv_scale_down" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/uvScaleUp"
                    style="@style/ToolButton.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="@string/uv_scale_up" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/uvFit"
                    style="@style/ToolButton.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="@string/uv_fit" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/uvRepack"
                    style="@style/ToolButton.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/uv_repack" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/uvFrameAtlas"
                    style="@style/ToolButton.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="@string/uv_frame_atlas" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="bottom"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/uvCancel"
                    style="@style/ToolButton.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/uv_cancel" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/uvApply"
                    style="@style/ToolButton.Tonal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="@string/uv_apply" />
            </LinearLayout>
        </LinearLayout>

        <!-- The compositor: the stack on top, the tools of the selected layer below. It scrolls
             because a phone cannot show eleven controls at 232 dp without stealing the model. -->
        <ScrollView
            android:id="@+id/texturePanel"
            android:layout_width="232dp"
            android:layout_height="match_parent"
            android:background="@color/editor_panel"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/texture_title"
                    android:textAllCaps="true"
                    android:textColor="@color/editor_text_dim"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textureSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="2dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/editor_text_dim"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/textureCanvas"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:autofillHints="none"
                        android:hint="@string/texture_canvas_hint"
                        android:inputType="number"
                        android:maxLength="5"
                        android:text="@string/texture_canvas_default"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/textureSetCanvas"
                        style="@style/ToolButton.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/texture_canvas_apply" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/textureImportImage"
                        style="@style/ToolButton.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/texture_import" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/textureBackground"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:autofillHints="none"
                        android:hint="@string/texture_background_hint"
                        android:inputType="textCapCharacters"
                        android:maxLength="7"
                        android:text="@string/texture_background_default"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/textureSetBackground"
                        style="@style/ToolButton.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/texture_background_apply" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/textureExport"
                        style="@style/ToolButton.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/texture_export" />
                </LinearLayout>

                <CheckBox
                    android:id="@+id/textureUvLines"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/texture_uv_lines"
                    android:textColor="@color/editor_text"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:text="@string/texture_stack_title"
                    android:textAllCaps="true"
                    android:textColor="@color/editor_text_dim"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/textureList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:text="@string/texture_tools_title"
                    android:textAllCaps="true"
                    android:textColor="@color/editor_text_dim"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/textureDuplicate"
                        style="@style/ToolButton.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/texture_duplicate" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/textureRemove"
                        style="@style/ToolButton.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="@string/texture_remove" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/textureMoveUpStack"
                        style="@style/ToolButton.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/texture_up" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/textureMoveDownStack"
                        style="@style/ToolButton.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="@string/texture_down" />
                </LinearLayout>

                <CheckBox
                    android:id="@+id/textureVisible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/texture_visible"
                    android:textColor="@color/editor_text"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/textureOpacityLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/texture_opacity"
                    android:textColor="@color/editor_text_dim"
                    android:textSize="11sp" />

                <SeekBar
                    android:id="@+id/textureOpacity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="100" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:orientation="vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/textureUp"
                        style="@style/ToolButton.Outlined"
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:text="@string/uv_move_up" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/textureLeft"
                            style="@style/ToolButton.Outlined"
                            android:layout_width="64dp"
                            android:layout_height="wrap_content"
                            android:text="@string/uv_move_left" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/textureDown"
                            style="@style/ToolButton.Outlined"
                            android:layout_width="64dp"
                            android:layout_height="wrap_content"
                            android:text="@string/uv_move_down" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/textureRight"
                            style="@style/ToolButton.Outlined"
                            android:layout_width="64dp"
                            android:layout_height="wrap_content"
                            android:text="@string/uv_move_right" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/textureRotateMinus90"
                        style="@style/ToolButton.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/uv_rotate_minus_90" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/textureRotateMinus15"
                        style="@style/ToolButton.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="@string/uv_rotate_minus_15" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/textureRotatePlus15"
                        style="@style/ToolButton.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="@string/uv_rotate_plus_15" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/textureRotatePlus90"
                        style="@style/ToolButton.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="@string/uv_rotate_plus_90" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/textureScaleDown"
                        style="@style/ToolButton.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/uv_scale_down" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/textureScaleUp"
                        style="@style/ToolButton.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="@string/uv_scale_up" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- One row of small controls replaces the two full-height bars the editor had, so the model
         loses one strip of pixels instead of two. -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:background="@color/editor_panel"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/importModel"
                style="@style/ToolButton.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/import_model" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/frameScene"
                style="@style/ToolButton.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/frame_scene" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/label_shading"
                android:textColor="@color/editor_text_dim"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/shadingGroup"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/shadingSolid"
                    style="@style/ToolButton.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/shading_solid" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/shadingNormals"
                    style="@style/ToolButton.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/shading_normals" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/shadingTexture"
                    style="@style/ToolButton.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/shading_texture" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/shadingChecker"
                    style="@style/ToolButton.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/shading_checker" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/label_view"
                android:textColor="@color/editor_text_dim"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/viewGroup"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/viewThreeD"
                    style="@style/ToolButton.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/view_three_d" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/viewSplit"
                    style="@style/ToolButton.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/view_split" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/viewAtlas"
                    style="@style/ToolButton.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/view_atlas" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/openUvEditor"
                style="@style/ToolButton.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:text="@string/open_uv_editor" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/openTexture"
                style="@style/ToolButton.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/open_texture" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/togglePanel"
                style="@style/ToolButton.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/toggle_panel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toggleLog"
                style="@style/ToolButton.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/toggle_log" />
        </LinearLayout>
    </HorizontalScrollView>

    <ScrollView
        android:id="@+id/outputScroll"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/editor_background">

        <TextView
            android:id="@+id/output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:textColor="@color/editor_text_dim"
            android:textIsSelectable="true"
            android:textSize="11sp"
            android:typeface="monospace" />
    </ScrollView>
</LinearLayout>
